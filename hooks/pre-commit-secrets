#!/usr/bin/env sh
# ============================================================================
# pre-commit-secrets  --  scan the staged diff for credentials before commit.
# ----------------------------------------------------------------------------
# Standalone, dependency-light wrapper. It runs the secret scanner in
# pre_commit_hooks/secrets.py against the files staged for commit and exits
# non-zero (blocking the commit) if it finds a real-looking secret. Obvious
# placeholders (nvapi-XXXX..., your_api_key_here, changeme) are ignored.
#
# This is the check that saves you from GitHub push protection (error GH013):
# it moves the "you committed a token" moment from push time -- after the
# secret is already in your history -- to commit time, where it is cheap.
#
# Use it directly for a smoke test:
#     git add .
#     ./hooks/pre-commit-secrets
#
# Or install it (and the rest) into a repo with:  python install.py
# Configuration lives in .githooks.yaml under the 'secrets:' key.
# Bypass once (you own the risk):  git commit --no-verify
# ============================================================================
here="$(cd "$(dirname "$0")" && pwd)"
PY="$(command -v python3 || command -v python)"
if [ -z "$PY" ]; then
  echo "pre-commit-secrets: python not found on PATH" >&2
  exit 1
fi
export PYTHONPATH="$here/..:${PYTHONPATH:-}"
exec "$PY" -m pre_commit_hooks.secrets "$@"
