#!/usr/bin/env sh
# ============================================================================
# pre-commit-largefiles  --  block oversized files, point at Git LFS.
# ----------------------------------------------------------------------------
# Measures each staged file by its staged blob size and blocks the commit when
# a file exceeds large_files.max_bytes (default 5 MiB), with a suggestion to
# track it with Git LFS. Files over the soft warn_bytes threshold get a warning
# but are allowed.
#
# Direct use:   ./hooks/pre-commit-largefiles
# Install all:  python install.py
# One-off limit override:  GITHOOKS_MAX_FILE_BYTES=20000000 git commit ...
# Bypass once:  git commit --no-verify
# ============================================================================
here="$(cd "$(dirname "$0")" && pwd)"
# Pick an interpreter: $GITHOOKS_PYTHON, else python3/python from PATH. Windows
# "App Execution Alias" stubs (.../WindowsApps/...) are only used as a last resort.
PY="${GITHOOKS_PYTHON:-}"
if [ -z "$PY" ]; then
  fallback=""
  for cand in python3 python; do
    found="$(command -v "$cand" 2>/dev/null)" || continue
    case "$found" in
      *WindowsApps*) [ -n "$fallback" ] || fallback="$found" ;;
      *) PY="$found"; break ;;
    esac
  done
  [ -n "$PY" ] || PY="$fallback"
fi
if [ -z "$PY" ]; then
  echo "pre-commit-largefiles: python not found on PATH (set GITHOOKS_PYTHON)" >&2
  exit 1
fi
# The dispatcher puts the package on sys.path itself (no PYTHONPATH juggling,
# which Git Bash on Windows cannot translate for a native Python).
exec "$PY" "$here/../githooks-run.py" run large-files "$@"
