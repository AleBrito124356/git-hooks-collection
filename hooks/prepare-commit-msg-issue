#!/usr/bin/env sh
# ============================================================================
# prepare-commit-msg-issue  --  link the commit to the branch issue id.
# ----------------------------------------------------------------------------
# Git passes the message file path plus an optional source. If the branch name
# contains an issue id (feature/ABC-123-thing -> ABC-123) and the message does
# not already mention it, a 'Refs: ABC-123' trailer is appended (or, with
# issue_prefix.mode: prefix, '[ABC-123] ' is prepended). Both forms pass the
# conventional-commit check. This hook never fails a commit.
#
# Direct use (against a file):  ./hooks/prepare-commit-msg-issue .git/COMMIT_EDITMSG
# Install all:  python install.py
# The branch pattern and template live in .githooks.yaml under 'issue_prefix:'.
# ============================================================================
here="$(cd "$(dirname "$0")" && pwd)"
# Pick an interpreter: $GITHOOKS_PYTHON, else python3/python from PATH. Windows
# "App Execution Alias" stubs (.../WindowsApps/...) are only used as a last resort.
PY="${GITHOOKS_PYTHON:-}"
if [ -z "$PY" ]; then
  fallback=""
  for cand in python3 python; do
    found="$(command -v "$cand" 2>/dev/null)" || continue
    case "$found" in
      *WindowsApps*) [ -n "$fallback" ] || fallback="$found" ;;
      *) PY="$found"; break ;;
    esac
  done
  [ -n "$PY" ] || PY="$fallback"
fi
if [ -z "$PY" ]; then
  echo "prepare-commit-msg-issue: python not found on PATH (set GITHOOKS_PYTHON)" >&2
  exit 1
fi
# The dispatcher puts the package on sys.path itself (no PYTHONPATH juggling,
# which Git Bash on Windows cannot translate for a native Python).
exec "$PY" "$here/../githooks-run.py" run issue-prefix "$@"
