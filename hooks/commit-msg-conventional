#!/usr/bin/env sh
# ============================================================================
# commit-msg-conventional  --  validate the message against Conventional Commits.
# ----------------------------------------------------------------------------
# Git passes the path to the proposed commit message as the first argument. This
# checks that the header looks like "type(scope): subject" with an allowed type
# and a sane length. Merge/revert/fixup messages are skipped.
#
# Direct use (against a file):  ./hooks/commit-msg-conventional .git/COMMIT_EDITMSG
# Install all:  python install.py
# Allowed types and limits live in .githooks.yaml under 'conventional_commit:'.
# Bypass once:  git commit --no-verify
# ============================================================================
here="$(cd "$(dirname "$0")" && pwd)"
# Pick an interpreter: $GITHOOKS_PYTHON, else python3/python from PATH. Windows
# "App Execution Alias" stubs (.../WindowsApps/...) are only used as a last resort.
PY="${GITHOOKS_PYTHON:-}"
if [ -z "$PY" ]; then
  fallback=""
  for cand in python3 python; do
    found="$(command -v "$cand" 2>/dev/null)" || continue
    case "$found" in
      *WindowsApps*) [ -n "$fallback" ] || fallback="$found" ;;
      *) PY="$found"; break ;;
    esac
  done
  [ -n "$PY" ] || PY="$fallback"
fi
if [ -z "$PY" ]; then
  echo "commit-msg-conventional: python not found on PATH (set GITHOOKS_PYTHON)" >&2
  exit 1
fi
# The dispatcher puts the package on sys.path itself (no PYTHONPATH juggling,
# which Git Bash on Windows cannot translate for a native Python).
exec "$PY" "$here/../githooks-run.py" run conventional-commit "$@"
