#!/usr/bin/env sh
# ============================================================================
# pre-push-tests  --  run a fast test subset before a push.
# ----------------------------------------------------------------------------
# Runs tests.command from .githooks.yaml, or auto-detects a runner (pytest if a
# tests/ directory exists; npm test if there is a package.json). If nothing is
# detected the hook passes quietly. Skip a single push with SKIP_TESTS=1.
#
# Direct use:   ./hooks/pre-push-tests
# Install all:  python install.py
# Bypass once:  git push --no-verify
# ============================================================================
here="$(cd "$(dirname "$0")" && pwd)"
# Pick an interpreter: $GITHOOKS_PYTHON, else python3/python from PATH. Windows
# "App Execution Alias" stubs (.../WindowsApps/...) are only used as a last resort.
PY="${GITHOOKS_PYTHON:-}"
if [ -z "$PY" ]; then
  fallback=""
  for cand in python3 python; do
    found="$(command -v "$cand" 2>/dev/null)" || continue
    case "$found" in
      *WindowsApps*) [ -n "$fallback" ] || fallback="$found" ;;
      *) PY="$found"; break ;;
    esac
  done
  [ -n "$PY" ] || PY="$fallback"
fi
if [ -z "$PY" ]; then
  echo "pre-push-tests: python not found on PATH (set GITHOOKS_PYTHON)" >&2
  exit 1
fi
# The dispatcher puts the package on sys.path itself (no PYTHONPATH juggling,
# which Git Bash on Windows cannot translate for a native Python).
exec "$PY" "$here/../githooks-run.py" run tests "$@"
