#!/usr/bin/env sh
# ============================================================================
# pre-commit-lint  --  lint the staged files with configured linters.
# ----------------------------------------------------------------------------
# Runs the linter configured per language (ruff check for Python, eslint for
# JS/TS by default) on the staged files only. A linter that is not installed is
# skipped. A non-zero linter exit blocks the commit when lint.fail_on_error is
# true (the default in .githooks.yaml).
#
# Direct use:   ./hooks/pre-commit-lint
# Install all:  python install.py
# Bypass once:  git commit --no-verify
# ============================================================================
here="$(cd "$(dirname "$0")" && pwd)"
# Pick an interpreter: $GITHOOKS_PYTHON, else python3/python from PATH. Windows
# "App Execution Alias" stubs (.../WindowsApps/...) are only used as a last resort.
PY="${GITHOOKS_PYTHON:-}"
if [ -z "$PY" ]; then
  fallback=""
  for cand in python3 python; do
    found="$(command -v "$cand" 2>/dev/null)" || continue
    case "$found" in
      *WindowsApps*) [ -n "$fallback" ] || fallback="$found" ;;
      *) PY="$found"; break ;;
    esac
  done
  [ -n "$PY" ] || PY="$fallback"
fi
if [ -z "$PY" ]; then
  echo "pre-commit-lint: python not found on PATH (set GITHOOKS_PYTHON)" >&2
  exit 1
fi
# The dispatcher puts the package on sys.path itself (no PYTHONPATH juggling,
# which Git Bash on Windows cannot translate for a native Python).
exec "$PY" "$here/../githooks-run.py" run lint "$@"
