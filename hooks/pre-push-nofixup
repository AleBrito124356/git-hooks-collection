#!/usr/bin/env sh
# ============================================================================
# pre-push-nofixup  --  block pushing fixup!/squash!/WIP commits.
# ----------------------------------------------------------------------------
# Git feeds the refs being pushed on stdin. This inspects the commit subjects in
# each pushed range and refuses the push if any are autosquash markers (fixup!,
# squash!, amend!) or match a WIP pattern, so half-finished work does not reach
# the remote. Fold them in first with:  git rebase -i --autosquash
#
# Direct use (checks HEAD vs upstream):  ./hooks/pre-push-nofixup
# Install all:  python install.py
# Bypass once:  git push --no-verify
# ============================================================================
here="$(cd "$(dirname "$0")" && pwd)"
# Pick an interpreter: $GITHOOKS_PYTHON, else python3/python from PATH. Windows
# "App Execution Alias" stubs (.../WindowsApps/...) are only used as a last resort.
PY="${GITHOOKS_PYTHON:-}"
if [ -z "$PY" ]; then
  fallback=""
  for cand in python3 python; do
    found="$(command -v "$cand" 2>/dev/null)" || continue
    case "$found" in
      *WindowsApps*) [ -n "$fallback" ] || fallback="$found" ;;
      *) PY="$found"; break ;;
    esac
  done
  [ -n "$PY" ] || PY="$fallback"
fi
if [ -z "$PY" ]; then
  echo "pre-push-nofixup: python not found on PATH (set GITHOOKS_PYTHON)" >&2
  exit 1
fi
# The dispatcher puts the package on sys.path itself (no PYTHONPATH juggling,
# which Git Bash on Windows cannot translate for a native Python).
exec "$PY" "$here/../githooks-run.py" run no-fixup "$@"
