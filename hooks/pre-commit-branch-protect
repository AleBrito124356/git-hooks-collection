#!/usr/bin/env sh
# ============================================================================
# pre-commit-branch-protect  --  refuse direct commits to main/master.
# ----------------------------------------------------------------------------
# Blocks a commit when the current branch is in branch_protect.protected
# (main and master by default). Override for a single commit by setting the
# escape-hatch variable:  ALLOW_COMMIT_TO_PROTECTED=1 git commit ...
#
# Direct use:   ./hooks/pre-commit-branch-protect
# Install all:  python install.py
# Bypass once:  git commit --no-verify
# ============================================================================
here="$(cd "$(dirname "$0")" && pwd)"
# Pick an interpreter: $GITHOOKS_PYTHON, else python3/python from PATH. Windows
# "App Execution Alias" stubs (.../WindowsApps/...) are only used as a last resort.
PY="${GITHOOKS_PYTHON:-}"
if [ -z "$PY" ]; then
  fallback=""
  for cand in python3 python; do
    found="$(command -v "$cand" 2>/dev/null)" || continue
    case "$found" in
      *WindowsApps*) [ -n "$fallback" ] || fallback="$found" ;;
      *) PY="$found"; break ;;
    esac
  done
  [ -n "$PY" ] || PY="$fallback"
fi
if [ -z "$PY" ]; then
  echo "pre-commit-branch-protect: python not found on PATH (set GITHOOKS_PYTHON)" >&2
  exit 1
fi
# The dispatcher puts the package on sys.path itself (no PYTHONPATH juggling,
# which Git Bash on Windows cannot translate for a native Python).
exec "$PY" "$here/../githooks-run.py" run branch-protect "$@"
