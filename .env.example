# git-hooks-collection has no application secrets of its own -- it is a set of
# git hooks. These are the optional environment variables the hooks respond to.
# Copy to .env only if your shell auto-loads it; otherwise just export them
# inline when you need them (e.g. ALLOW_COMMIT_TO_PROTECTED=1 git commit ...).

# Path to a non-default config file. Defaults to <repo>/.githooks.yaml.
GITHOOKS_CONFIG=

# Comma-separated check names to skip for the current invocation.
# e.g. GITHOOKS_SKIP=lint,tests
GITHOOKS_SKIP=

# One-off override to allow a commit on a protected branch (main/master).
# The variable name is configurable via branch_protect.allow_env.
ALLOW_COMMIT_TO_PROTECTED=

# One-off override of the large-file byte limit (bytes).
GITHOOKS_MAX_FILE_BYTES=

# Skip the pre-push test run for a single push.
SKIP_TESTS=

# Set to any value to disable coloured output (respected everywhere).
NO_COLOR=
